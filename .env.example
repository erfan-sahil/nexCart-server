NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=10kb
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
