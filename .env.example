MONGODB_URI=mongodb://nexcart:nexcart@127.0.0.1:27017/nexcart?authSource=admin
REDIS_URL=redis://:nexcart@127.0.0.1:6379
MONGO_ROOT_USERNAME=nexcart
MONGO_ROOT_PASSWORD=nexcart
MONGO_DATABASE=nexcart
REDIS_PASSWORD=nexcart
