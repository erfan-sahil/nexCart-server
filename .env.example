NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000,http://localhost:5174,http://localhost:5175
BODY_LIMIT=10kb
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false
MONGODB_URI=mongodb://nexcart:nexcart@127.0.0.1:27017/nexcart?authSource=admin&replicaSet=rs0&directConnection=true
REDIS_URL=redis://:nexcart@127.0.0.1:6379
# Set REDIS_ENABLED=false to run without Redis (in-memory rate limits, no cache).
REDIS_ENABLED=true
# When true, startup and /api/health/ready fail if Redis is unreachable.
REDIS_REQUIRED=false
# Defaults to "nexcart:<NODE_ENV>:" so environments can share one Redis safely.
REDIS_KEY_PREFIX=
CACHE_DEFAULT_TTL_SECONDS=60
MONGO_ROOT_USERNAME=nexcart
MONGO_ROOT_PASSWORD=nexcart
MONGO_DATABASE=nexcart
REDIS_PASSWORD=nexcart
JWT_ACCESS_SECRET=dev-only-access-secret-change-me!!
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_NAME=refreshToken
AUTH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_MAX=20
BCRYPT_ROUNDS=12
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:4000
CLIENT_APP_URL=http://localhost:3000

# Google OAuth (add the callback URL in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Image storage: "local" writes to UPLOAD_DIR, "cloudinary" uploads to Cloudinary.
IMAGE_STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nexcart

# SSLCommerz sandbox (local and production demo). Get test credentials from
# https://developer.sslcommerz.com/registration/ . No real money moves in sandbox.
# SSLCOMMERZ_MOCK=true skips the gateway entirely (local development only).
SSLCOMMERZ_MOCK=false
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
