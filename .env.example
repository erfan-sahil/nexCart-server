NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=10kb
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false
MONGODB_URI=mongodb://nexcart:nexcart@127.0.0.1:27017/nexcart?authSource=admin
REDIS_URL=redis://:nexcart@127.0.0.1:6379
MONGO_ROOT_USERNAME=nexcart
MONGO_ROOT_PASSWORD=nexcart
MONGO_DATABASE=nexcart
REDIS_PASSWORD=nexcart
JWT_ACCESS_SECRET=dev-only-access-secret-change-me!!
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_NAME=refreshToken
AUTH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_MAX=20
BCRYPT_ROUNDS=12
UPLOAD_DIR=uploads
